# Copy to `.env.test` and adjust. Tests refuse to run unless
# NODE_ENV=test and the test database name matches TEST_DATABASE_NAME.

NODE_ENV=test
HOST=0.0.0.0
PORT=0
LOG_LEVEL=silent
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://app:app@localhost:5433/app_test
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/app_test
TEST_DATABASE_NAME=app_test

CORS_ORIGINS=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=1000

EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
