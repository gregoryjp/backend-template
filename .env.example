# Copy to `.env` and adjust. Never commit `.env`.
# The app validates this on boot and fails fast on unknown/malformed values.

# --- Runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL (provided by `docker compose up -d postgres`) ---
DATABASE_URL=postgresql://app:app@localhost:5433/app

# --- CORS: comma-separated list of allowed origins ---
CORS_ORIGINS=http://localhost:3000

# --- Token lifetimes (seconds) ---
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

# --- Legal consent required at registration (PRD decides which are mandatory) ---
LEGAL_TERMS_REQUIRED=true
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_REQUIRED=true
LEGAL_PRIVACY_VERSION=1.0
LEGAL_MARKETING_VERSION=1.0

# --- Auth abuse protection ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- Email adapter: "console" logs to stdout; "smtp" uses SMTP_* below ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
